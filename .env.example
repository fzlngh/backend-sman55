# Isi dari Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_OR_SECRET_KEY
ADMIN_PASSWORD=replace-with-a-long-unique-password
ALLOWED_ORIGIN=http://localhost:3000
PORT=8080

# Opsional: kirim agregat nama kandidat ke Google Sheets.
SHEET_URL=
SHEET_SECRET=

# Hanya untuk impor satu kali dari file data.json lama, bila tersedia.
LEGACY_DATA_FILE=data.json
